<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/QuietMSI.Core/QuietMSI.Core.csproj" />
    <!-- Compile the exact UI sources independently of Program and transport. -->
    <Compile Include="../../src/QuietMSI/UI/**/*.cs" Link="UI/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/QuietMSI/UIHost.cs" Link="UIHost.cs" Condition="Exists('../../src/QuietMSI/UIHost.cs')" />
  </ItemGroup>
</Project>
